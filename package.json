{
  "name": "premium-wire-cable-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-deploy-seo.mjs",
    "build:production": "vite build --mode production && node scripts/generate-deploy-seo.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run lint && npm run build:production",
    "analyze": "vite-bundle-visualizer",
    "generate:logo-assets": "node scripts/generate-logo-assets.mjs",
    "deploy:liara:web": "npm run build:production && cd dist && liara deploy --platform=static",
    "deploy:liara:api": "cd server && liara deploy --platform=node --port=3000"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.10",
    "axios": "^1.20.0",
    "dompurify": "^3.4.15",
    "framer-motion": "^12.35.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "react-hot-toast": "^2.6.0",
    "react-intersection-observer": "^10.0.3",
    "react-router-dom": "^6.30.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.15",
    "vite": "^8.3.0",
    "vite-bundle-visualizer": "^1.2.1"
  }
}
