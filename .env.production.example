# Production Environment Variables — Liara Deployment
# Copy to .env.production locally before: npm run build:production
# Backend variables go in Liara Console → API app → Environment Variables (NOT here)

# ============================================
# SITE (frontend — baked in at build time)
# ============================================
VITE_SITE_URL=https://setarehkerman.com
VITE_SITE_NAME=Setareh Kerman Wire & Cable

# Your Liara Node API app URL until custom domain is connected, then use:
# https://api.setarehkerman.com
VITE_API_BASE_URL=https://api.setarehkerman.com

# ============================================
# ANALYTICS (optional)
# ============================================
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CHATBOT=false

# ============================================
# BACKEND — set ONLY in Liara Console for the API app
# ============================================
# NODE_ENV=production
# PORT=5000
# CORS_ALLOWED_ORIGINS=https://setarehkerman.com,https://www.setarehkerman.com,https://YOUR-WEB-APP.liara.run
# CONTACT_EMAIL_TO=info.setarehkerman@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-16-character-gmail-app-password
# SMTP_FROM="Setareh Kerman Website <your-gmail@gmail.com>"
# OPENAI_API_KEY=
