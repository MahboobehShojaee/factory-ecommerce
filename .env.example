# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000
VITE_ENABLE_CHATBOT=false
VITE_ENABLE_ANALYTICS=false
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=

# Backend (place these only in your Liara API app's Environment Variables section)
NODE_ENV=development
PORT=5000
# Comma-separated browser addresses allowed to call the API. Keep production exact.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAI_API_KEY=

# Contact form email (Nodemailer SMTP — credentials stay on server only)
CONTACT_EMAIL_TO=info.setarehkerman@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-account@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Setareh Kerman Website <your-smtp-account@gmail.com>"
