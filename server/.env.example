# Use these values in Liara Console → API app → Environment Variables.
NODE_ENV=production
# Local dev only — on Liara, PORT is set automatically (default 3000). Do not add PORT in Liara Console.
PORT=5000
CORS_ALLOWED_ORIGINS=https://setarehkerman.com,https://www.setarehkerman.com
CONTACT_EMAIL_TO=info.setarehkerman@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-account@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
SMTP_FROM="Setareh Kerman Website <your-smtp-account@gmail.com>"

# Optional: required only when the AI chat feature is deliberately enabled.
OPENAI_API_KEY=
